# auto = Twelve Data if TWELVE_DATA_API_KEY is set, else yfinance.
# yfinance / twelvedata force one source (twelvedata requires the key).
MARKET_DATA_PROVIDER=auto
# When set (and provider is auto/twelvedata), Twelve Data is the primary
# source; any ticker it cannot serve falls back to yfinance automatically.
# Prefer the secret file below over putting the key here.
TWELVE_DATA_API_KEY=
# Path to a file containing the bare key (chmod 600), e.g. a read-only secret
# mount. Used when TWELVE_DATA_API_KEY is empty — keeps the key out of the repo.
# docker-compose mounts /opt/secrets/twelvedata.key to this path.
TWELVE_DATA_API_KEY_FILE=
# Seed watchlist (comma-separated): on startup, any ticker here missing from the
# DB is added. Additive only — a UI delete of a listed ticker returns on restart.
WATCHLIST=AAPL,GC=F,ICLN,IFX.DE,MSFT,NVDA,SPCX,SPY,TSLA,URTH

# --- PROD/DEV database switch ---
# Second SQLite DB as a disposable sandbox: backfills and resets are DEV-only
# (the UI hides them while PROD is selected); savings writes are PROD-only.
# Empty/unset = feature disabled: no dev engine, every request serves PROD.
# The DEV db is auto-seeded from PROD on startup and re-clonable via the UI.
# Must be a file path (never :memory:) and never the PROD file — both are
# refused at startup with an error log and the feature stays off.
# sqlite+aiosqlite:////data/... = absolute path inside the container's /data.
DATABASE_URL_DEV=

OLLAMA_URL=http://host.docker.internal:11434
# Legacy single-backend settings: used only when LLM_BACKENDS is not set.
# Set to an Ollama model tag you have pulled, e.g. qwen3:32b, llama3.1:8b, etc.
OLLAMA_MODEL=
# Generic LLM read timeout in seconds (matches the code default in
# app/config.py: ollama_timeout_seconds = 1200.0).
OLLAMA_TIMEOUT_SECONDS=1200

# --- Multi-backend LLM configuration (preferred) ---
# JSON list of backends; switch between them at runtime from the dashboard
# dropdown (persisted in the /data volume). type "ollama" speaks Ollama's
# native /api/chat; type "openai" speaks OpenAI-compatible /v1/chat/completions
# (llama.cpp llama-server, vLLM, LiteLLM, ...). The optional "api_key" field
# is sent as a Bearer token (needed for LiteLLM proxy). Single line required
# (dotenv does not support multi-line values):
# LLM_BACKENDS=[{"name":"llama-server","type":"openai","url":"http://your-server-ip:4000","model":"qwen3.8-27b"},{"name":"ollama","type":"ollama","url":"http://host.docker.internal:11434","model":"qwen3:32b"}]
#
# Optional per-backend "api_key" field is sent as a Bearer token. If omitted,
# the key is read from LITELLM_API_KEY_FILE — the *_FILE convention: the key
# lives in a single read-only secret file, never in an env file. In this
# deployment docker-compose.yml sets LITELLM_API_KEY_FILE=/run/secrets/litellm.key
# and mounts /opt/secrets/litellm.key there (same pattern as
# TWELVE_DATA_API_KEY_FILE above). The legacy LITELLM_API_KEY env var is only
# the last-resort fallback (see app/llm.py _auth_headers).

# Qwen3 thinking budget applied to OpenAI-compatible backends (llama-server).
# The vocabulary is SERVER-SPECIFIC (the app sends the operator's value
# verbatim and the server validates it): the Mistral route answers
# none/low/high/xhigh/max and rejects medium; llama-server (llama.cpp)
# takes low/medium/high/xhigh. Empty = leave the server's default.
LLM_REASONING_EFFORT=max

# --- News search via SearXNG (optional) ---
# Leave empty to disable. Set to your SearXNG instance URL to include
# recent news headlines in the sim bot's LLM context and the chat endpoint.
# In this deployment the container joins the stacks-shared docker network,
# so the path is the engine's container URL, not the published LAN port.
SEARXNG_URL=
SEARXNG_TIMEOUT=10

# --- The shared searxng MCP tool server (the type-D material-news agent,
# app/newsagent.py; docs/sell-news-agent-design-2026-11-01.md) ---
# Leave empty to disable the D step. In this deployment the container joins
# the stacks-shared docker network, so the path is the MCP stack's
# container URL (http://searxng-mcp:8808/mcp), not a published port.
SEARXNG_MCP_URL=
SEARXNG_MCP_TIMEOUT_S=30
# Where the nightly type-D shadow news scan writes its artifacts (the JSONL
# consult log + the run artifact). The container is read-only except /data
# and /tmp, so the default lives under /data.
SIM_NEWS_OUT_DIR=/data/news-out

PAPER_TRADING=true

# --- Autonomous paper-trading simulation ---
SIM_ENABLED=true
SIM_MONTHLY_ALLOWANCE=1000
SIM_START_CASH=0
SIM_UNIVERSE=diversified-plus
SIM_STRATEGY=deterministic
SIM_MAX_POSITION_PCT=10
SIM_MIN_CASH_PCT=5
SIM_MAX_POSITIONS=10
SIM_STOP_PCT=15
# Block BUYs when price has risen more than this % in the last 5 days
# (prevents chasing short-term spikes). 0 = disabled. Walk-forward chose 12%.
SIM_MAX_RUN_5D=12
# Scheduler run time in UTC (24h). 23:30 UTC = 01:30 Europe/Vienna (CEST).
# Late enough that the prefetch (run - SIM_PREFETCH_LEAD_MINUTES) lands after
# the US close in EST too: 23:30 - 90m = 22:00 UTC = 17:00 ET. At 22:30 UTC the
# prefetch hit 16:00 ET (the close) in EST and often stored the prior bar.
# The scheduled cycles (and the prefetch) are skipped on weekends and NYSE
# holidays — the sim only runs on trading days.
SIM_RUN_HOUR=23
SIM_RUN_MINUTE=30
# Nightly shared universe prefetch: all sims share one universe, so it is
# fetched ONCE before the cycles (which then skip tickers fetched within
# MARKET_FRESH_SECONDS). Uses the configured provider (auto → Twelve Data,
# paced/budgeted) with a per-ticker yfinance fallback.
SIM_UNIVERSE_PREFETCH=true
SIM_PREFETCH_LEAD_MINUTES=90
# After the prefetch, recompute the screener table from the freshly cached
# candles (no provider calls) so the Dashboard table updates nightly instead of
# only when "Update" is pressed. Runs only after a successful
# SIM_UNIVERSE_PREFETCH; app-level (works even with SIM_ENABLED=false).
SCREENER_AUTO_RESCORE=true
MARKET_FRESH_SECONDS=21600
# Nightly watchlist prefetch: fetch the watchlist with the configured provider
# at SIM_RUN_HOUR so the Dashboard opens from the DB. App-level — runs even when
# SIM_ENABLED / SIM_UNIVERSE_PREFETCH are false.
WATCHLIST_PREFETCH=true
# Generated universes (e.g. the auto-synced S&P 500) are written here. The
# container is read_only, so this must live on the writable /data volume; a
# generated file shadows the repo's universes/<name>.txt bootstrap list.
UNIVERSE_EXTRA_DIR=/data/universes
# Weekly refresh of the S&P 500 constituent list from the iShares IVV holdings
# CSV (one upstream request, no candles). App-level — runs even when
# SIM_ENABLED=false. 0=Monday .. 6=Sunday, hour UTC. The same refresh is also
# available on demand via the "Sync SP500" button.
UNIVERSE_SYNC_ENABLED=true
UNIVERSE_SYNC_WEEKDAY=6
UNIVERSE_SYNC_HOUR=6
# Twelve Data Basic limits: pace to N/min and stop using it once the daily
# budget is spent (the rest of the day falls back to yfinance). 800/day hard cap.
TWELVE_DATA_MAX_PER_MIN=8
TWELVE_DATA_DAILY_BUDGET=750

# --- Monthly qv-mom portfolio (separate paper portfolio) ---
# stockstrat qv-mom-v1: top-10 quality-value-momentum, monthly rebalance on
# the last trading day, hysteresis band 20, equal weight. Runs independently
# of the daily sim cycle. SIM_MONTHLY_ALLOWANCE doubles as its deposit.
SIM_MONTHLY_ENABLED=true
SIM_MONTHLY_UNIVERSE=diversified-plus
SIM_MONTHLY_CONTRIBUTION=1000
SIM_MONTHLY_TARGET_N=10
SIM_MONTHLY_HOLD_BAND=20

# SEC EDGAR: www.sec.gov (the CIK-map download) answers 403 for User-Agents
# without a contact email; data.sec.gov (companyfacts) does not. Set your real
# address to (re)download the CIK map so new tickers get as-reported,
# point-in-time fundamentals; leave blank and the cached map is used (unknown
# tickers fall back to yfinance). Optional.
SEC_CONTACT_EMAIL=

# --- Savings tracker (real money, EUR — independent of SIM_ENABLED) ---
# Seeds a fresh initialization only; the rate and monthly transfer are
# editable at runtime in the Savings tab (persisted in the DB). The daily
# pass accrues interest, runs due Sparpläne and writes the equity snapshot
# every calendar day at SAVINGS_SNAPSHOT_HOUR:MINUTE (UTC).
SAVINGS_ENABLED=true
SAVINGS_INTEREST_RATE=3.0
SAVINGS_MONTHLY_TRANSFER=0
SAVINGS_SNAPSHOT_HOUR=23
SAVINGS_SNAPSHOT_MINUTE=40
