# Valid values: yfinance (default, US + EU best-effort) or twelvedata
MARKET_DATA_PROVIDER=yfinance
# Only needed when MARKET_DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=
WATCHLIST=AAPL,MSFT,NVDA,VOO,IFX.DE,OMV.VI
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.6:27b-q3_K_M
OLLAMA_TIMEOUT_SECONDS=180
PAPER_TRADING=true

# --- Autonomous paper-trading simulation ---
SIM_ENABLED=true
SIM_MONTHLY_ALLOWANCE=1000
SIM_START_CASH=0
SIM_UNIVERSE=global-large-cap
SIM_STRATEGY=deterministic
SIM_MAX_POSITION_PCT=15
SIM_MIN_CASH_PCT=5
SIM_RUN_HOUR=22
