# Valid values: yfinance (default, US + EU best-effort) or twelvedata
MARKET_DATA_PROVIDER=yfinance
# Only needed when MARKET_DATA_PROVIDER=twelvedata
TWELVE_DATA_API_KEY=
WATCHLIST=AAPL,MSFT,NVDA,IFX.DE
OLLAMA_URL=http://host.docker.internal:11434
# Legacy single-backend settings: used only when LLM_BACKENDS is not set.
# Set to an Ollama model tag you have pulled, e.g. qwen3:32b, llama3.1:8b, etc.
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=600

# --- Multi-backend LLM configuration (preferred) ---
# JSON list of backends; switch between them at runtime from the dashboard
# dropdown (persisted in the /data volume). type "ollama" speaks Ollama's
# native /api/chat; type "openai" speaks OpenAI-compatible /v1/chat/completions
# (llama.cpp llama-server, vLLM, LiteLLM, ...). Single line required (dotenv
# does not support multi-line values):
# LLM_BACKENDS=[{"name":"llama-server","type":"openai","url":"http://192.168.0.46:8084","model":"Qwen3.8-27B-IQ4_XS.gguf"},{"name":"ollama","type":"ollama","url":"http://host.docker.internal:11434","model":"qwen3:32b"}]

# Qwen3 thinking budget applied to OpenAI-compatible backends (llama-server).
# One of: low | medium | high | xhigh. Empty = leave the server's startup
# default untouched (useful if you pass --reasoning-budget to llama-server).
LLM_REASONING_EFFORT=medium

# --- News search via SearXNG (optional) ---
# Leave empty to disable. Set to your SearXNG instance URL to include
# recent news headlines in the sim bot's LLM context and the chat endpoint.
SEARXNG_URL=
SEARXNG_TIMEOUT=10

PAPER_TRADING=true

# --- Autonomous paper-trading simulation ---
SIM_ENABLED=true
SIM_MONTHLY_ALLOWANCE=1000
SIM_START_CASH=0
SIM_UNIVERSE=global-large-cap
SIM_STRATEGY=deterministic
SIM_MAX_POSITION_PCT=10
SIM_MIN_CASH_PCT=5
SIM_MAX_POSITIONS=10
SIM_STOP_PCT=15
# Block BUYs when price has risen more than this % in the last 5 days
# (prevents chasing short-term spikes). 0 = disabled. Walk-forward chose 12%.
SIM_MAX_RUN_5D=12
# Scheduler run time in UTC (24h). 22 UTC = 00:00 Europe/Vienna (CEST).
SIM_RUN_HOUR=22
SIM_RUN_MINUTE=30
